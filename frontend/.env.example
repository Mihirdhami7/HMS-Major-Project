# Backend API base URL (must end with /api)
# Recommended: /api  -> the site calls the API on its own address:
#   local dev  : Vite forwards /api and /media to the backend (see vite.config.js, VITE_PROXY_TARGET)
#   production : Vercel rewrites /api/* and /media/* to the backend (vercel.json)
# Same-site requests keep the httpOnly login session cookie working.
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api and /media (local dev only)
VITE_PROXY_TARGET=http://127.0.0.1:8000
